{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.csr.html", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "cartelera",
      "urls": [
        "https://*.supabase.co/rest/v1/peliculas**",
        "https://*.supabase.co/rest/v1/puntajes_peliculas**",
        "https://*.supabase.co/rest/v1/funciones**",
        "https://*.supabase.co/rest/v1/resenias**",
        "https://*.supabase.co/rest/v1/rpc/ranking_ventas**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 100,
        "maxAge": "1d"
      }
    }
  ]
}
